# Laravel Production Environment Settings for Docker / Synology NAS
# Copy this file to '.env' in your production directory and fill in the secrets.

# ==============================================================================
# 1. Core Application Settings
# ==============================================================================
APP_NAME="Employee Portal"
APP_ENV=production
APP_DEBUG=false

# Generate a 32-character base64 key. You can generate one by running:
# docker run --rm employee-portal-app:latest php artisan key:generate --show
APP_KEY=

# The URL of your application (used for generating links, emails, etc.).
# If using HTTPS (recommended via Synology Reverse Proxy), make sure it starts with https://
APP_URL=https://employee.yourdomain.com

# ==============================================================================
# 2. Database Configuration
# ==============================================================================
# Using MySQL container named 'db' within the Docker Compose network
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=employee_portal
DB_USERNAME=portal_admin

# DO NOT use default passwords like 'password'. Choose a strong random password.
DB_PASSWORD=

# ==============================================================================
# 3. Redis Caching, Sessions, & Queues
# ==============================================================================
# Using Redis container named 'redis' within the Docker Compose network
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ==============================================================================
# 4. Email Configuration (SMTP)
# ==============================================================================
# Configure your outgoing mail server here.
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# 5. External Integrations (JPayroll API)
# ==============================================================================
# Modify these to point to your company's JPayroll instance.
JPAYROLL_API_URL=http://192.168.6.75/JPayroll/thirdparty/ext
JPAYROLL_API_KEY=
JPAYROLL_COMPANY_AREA=

# ==============================================================================
# 6. Logging Settings
# ==============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
